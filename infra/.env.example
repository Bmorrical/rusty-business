# Settings for the Docker stack. `make bootstrap` copies this file to
# infra/.env and fills every empty *_PASSWORD line with a new random value.
# infra/.env is ignored by git; this example never holds a real password.

# Postgres
POSTGRES_DB=rusty
POSTGRES_USER=rusty
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# MinIO (file storage)
MINIO_ROOT_USER=rusty
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=rusty-business

# Ports on this computer. Each one binds to 127.0.0.1 only. Change a number
# here if something else already uses it.
PORT_FRONT_DOOR=4700
PORT_API=4701
PORT_MAILPIT_SMTP=4725
PORT_MAILPIT_UI=4726
PORT_POSTGRES=4732
PORT_REDIS=4779
PORT_MINIO=4790
PORT_MINIO_CONSOLE=4791
